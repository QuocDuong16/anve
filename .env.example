# AnVề local environment.
#
# Copy to .env and adjust. `make up` reads this file through Docker Compose;
# the Go binary reads the same variables when it runs outside Docker.

# ─── Server ───────────────────────────────────────────────────────────────────
API_PORT=8080
ENVIRONMENT=development
# Exact bind address of the Go binary. Leave empty for the safe development
# default (127.0.0.1:8080, never reachable from the network). Outside
# development LISTEN_ADDR is mandatory, and Compose sets 0.0.0.0 inside the
# container while publishing the host port on 127.0.0.1 only.
# LISTEN_ADDR=127.0.0.1:8080
# Bounded by SHUTDOWN_TIMEOUT; raise it when the API serves long requests.
SHUTDOWN_TIMEOUT=15s

# ─── Database ────────────────────────────────────────────────────────────────
# The credentials below are the Docker Compose defaults. Change them before
# exposing the stack outside the local machine.
POSTGRES_USER=anve
POSTGRES_PASSWORD=anve
POSTGRES_DB=anve
# Port the dev database publishes on the host. The Compose file binds it to
# 127.0.0.1 only, so the database is never reachable from other machines.
POSTGRES_PORT=5432

# Connection string used by the Go binary and the migrator when they run
# outside Docker. Inside Docker the compose file builds its own URL.
DATABASE_URL=postgres://anve:anve@localhost:5432/anve?sslmode=disable

# ─── Authentication (M1) ─────────────────────────────────────────────────────
# OAuth 2.0 Web Client ID from Google Cloud Console. The Android app obtains
# Google ID tokens for this audience; the Go server verifies them against the
# same value. Leave empty to disable Google sign-in (the endpoint fails
# closed with 503 AUTH_NOT_CONFIGURED).
AUTH_GOOGLE_CLIENT_ID=
# Optional Firebase project ID. Server push is disabled when empty; supply
# Application Default Credentials separately, never in this file.
FCM_PROJECT_ID=
# Development-only sign-in without an identity provider. The server refuses
# to start with this enabled unless ENVIRONMENT is exactly "development":
# staging, production, mis-cased and unknown names are rejected, and the
# endpoint is not even mounted when the flag is false. It also refuses a
# non-loopback listener without the explicit opt-in and allowlist below.
# Never point it at a production database, and remember it mints sessions
# for arbitrary emails (see ADR 0004 and ADR 0005).
AUTH_DEV_LOGIN_ENABLED=false
# Required only when the development login is enabled on a non-loopback
# listener (the Compose API container). The request source must also be in
# AUTH_DEV_LOGIN_ALLOWED_CIDRS; the host port stays loopback-only either way.
# AUTH_DEV_LOGIN_ALLOW_NETWORK=true
# AUTH_DEV_LOGIN_ALLOWED_CIDRS=127.0.0.0/8,::1/128,172.28.0.0/24

# ─── Location retention (M3) ─────────────────────────────────────────────────
# Consented location points are deleted this many days after the device
# CAPTURE time (not the upload time). The same window bounds late offline
# uploads: anything older is refused instead of stored and immediately
# purged. Allowed range 1..365; the default is deliberately short while
# Location History (M5) is unimplemented.
LOCATION_RETENTION_DAYS=30

# ─── Timezone ────────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh

# ─── Docker Compose ──────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=anve
