# AnVề local environment.
#
# Copy to .env and adjust. `make up` reads this file through Docker Compose;
# the Go binary reads the same variables when it runs outside Docker.

# ─── Server ───────────────────────────────────────────────────────────────────
API_PORT=8080
ENVIRONMENT=development
# Bounded by SHUTDOWN_TIMEOUT; raise it when the API serves long requests.
SHUTDOWN_TIMEOUT=15s

# ─── Database ────────────────────────────────────────────────────────────────
# The credentials below are the Docker Compose defaults. Change them before
# exposing the stack outside the local machine.
POSTGRES_USER=anve
POSTGRES_PASSWORD=anve
POSTGRES_DB=anve
# Port the dev database publishes on the host. The Compose file binds it to
# 127.0.0.1 only, so the database is never reachable from other machines.
POSTGRES_PORT=5432

# Connection string used by the Go binary and the migrator when they run
# outside Docker. Inside Docker the compose file builds its own URL.
DATABASE_URL=postgres://anve:anve@localhost:5432/anve?sslmode=disable

# ─── Authentication (M1) ─────────────────────────────────────────────────────
# OAuth 2.0 Web Client ID from Google Cloud Console. The Android app obtains
# Google ID tokens for this audience; the Go server verifies them against the
# same value. Leave empty to disable Google sign-in (the endpoint fails
# closed with 503 AUTH_NOT_CONFIGURED).
AUTH_GOOGLE_CLIENT_ID=
# Development-only sign-in without an identity provider. Refused at startup
# when ENVIRONMENT=production; never enable it outside local development.
AUTH_DEV_LOGIN_ENABLED=false

# ─── Timezone ────────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh

# ─── Docker Compose ──────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=anve
