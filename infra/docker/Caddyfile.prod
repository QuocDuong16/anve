http://{$API_DOMAIN} {
	encode zstd gzip
	@landing path / /privacy /delete-account /invite /.well-known/assetlinks.json /assets/*
	handle @landing {
		reverse_proxy api:8080
	}
	@api path /api/*
	handle @api {
		reverse_proxy api:8080
	}
	@health path /healthz /readyz
	handle @health {
		reverse_proxy api:8080
	}
	handle {
		respond "Not Found" 404
	}
}
