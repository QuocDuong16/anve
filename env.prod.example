# Production API deployment. Copy to env.prod, replace the values, then chmod 600 env.prod.
# Never commit env.prod or place Play upload/signing credentials here.

ENVIRONMENT=production
LISTEN_ADDR=0.0.0.0:8080
API_DOMAIN=api.anve.niand.id.vn
HTTP_PORT=24080
HTTPS_PORT=24443

POSTGRES_USER=anve
# Generate with: openssl rand -hex 32 (64 hexadecimal characters)
POSTGRES_PASSWORD=replace_with_64_hex_characters
POSTGRES_DB=anve

# Google Cloud OAuth Web client ID used by Android ID-token authentication.
AUTH_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
AUTH_DEV_LOGIN_ENABLED=false

# Leave FCM_PROJECT_ID empty until Firebase is configured. When enabled,
# point this at a service-account credential file outside the repository.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=/dev/null

# Retention window for consented location points, 1..365 days.
LOCATION_RETENTION_DAYS=30
TZ=Asia/Ho_Chi_Minh
