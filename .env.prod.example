# Production API deployment. Copy to .env.prod, replace the values, then chmod 600 .env.prod.
# Never commit .env.prod or place Play upload/signing credentials here.

ENVIRONMENT=production
# Port listened to inside the API container; Caddy proxies to api:8080.
LISTEN_ADDR=0.0.0.0:8080
API_DOMAIN=anve.niand.id.vn
# Host port published by Caddy's HTTP listener for the Cloudflare Tunnel origin.
HTTP_PORT=24080

POSTGRES_USER=anve
# Generate with: openssl rand -hex 32 (64 hexadecimal characters)
POSTGRES_PASSWORD=replace_with_64_hex_characters
POSTGRES_DB=anve

# Google Cloud OAuth Web client ID used by Android ID-token authentication.
AUTH_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
AUTH_DEV_LOGIN_ENABLED=false

# Leave FCM_PROJECT_ID empty until Firebase is configured. When enabled,
# point this at a service-account credential file outside the repository.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=/dev/null

# Retention window for consented location points, 1..365 days.
LOCATION_RETENTION_DAYS=30
TZ=Asia/Ho_Chi_Minh

# Optional contact form notification channels (SMTP & Telegram Bot).
# When unset, contact submissions still store in PostgreSQL without failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AnVe <no-reply@anve.niand.id.vn>"
NOTIFY_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Android App Links (`/.well-known/assetlinks.json`).
# Comma-separated SHA-256 certificate fingerprints (Play App Signing, etc.) in
# AA:BB:... uppercase colon-hex format. Empty disables `assetlinks.json` (404).
ANDROID_ASSETLINKS_PACKAGE=com.anve.app
ANDROID_ASSETLINKS_SHA256=
